{
  "builds": [
    { "src": "backend/run.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/run.py" },
    { "src": "/admin", "dest": "/frontend/tickets/admin/login.html" },
    { "src": "/admin/dashboard", "dest": "/frontend/tickets/admin/dashboard.html" },
    { "src": "/admin/tickets", "dest": "/frontend/tickets/admin/tickets.html" },
    { "src": "/admin/inventario", "dest": "/frontend/tickets/admin/inventario.html" },
    { "src": "/admin/reportes", "dest": "/frontend/tickets/admin/reportes.html" },
    { "src": "/admin/piezas", "dest": "/frontend/tickets/admin/piezas.html" },
    { "src": "/admin/servicios", "dest": "/frontend/tickets/admin/servicios.html" },
    { "src": "/admin/siniestros", "dest": "/frontend/tickets/admin/siniestros.html" },
    { "src": "/admin/configuracion", "dest": "/frontend/tickets/admin/configuracion.html" },
    { "src": "/global", "dest": "/frontend/tickets/admin/global-login.html" },
    { "src": "/global/panel", "dest": "/frontend/tickets/admin/global-panel.html" },
    { "src": "/", "dest": "/frontend/tickets/usuario/index.html" },
    { "src": "/operador", "dest": "/frontend/tickets/operador/index.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
