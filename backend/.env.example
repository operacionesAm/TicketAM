SUPABASE_URL=https://your-project.supabase.co
# Service role key: el backend Flask corre en el servidor, nunca en el
# navegador, así que puede usarla de forma segura. No la subas a git ni la
# expongas en el frontend.
SUPABASE_SERVICE_KEY=your-service-role-key
FLASK_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# Opcional: notificaciones por correo cuando llega un ticket nuevo (ver
# app/mailer.py). Sin estas variables, el backend sigue funcionando igual,
# solo no envía el correo. Cualquier SMTP sirve (Gmail con contraseña de
# aplicación, Outlook, Zoho, un SMTP corporativo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: enviar como una cuenta real de Google ("Conectar con Google" en
# /admin/configuracion) en vez de SMTP — para dominios donde Sistemas bloquea
# las contraseñas de aplicación. Se crean en https://console.cloud.google.com
# (ver README, sección "Notificaciones por correo"). Si un departamento tiene
# cuenta de Google conectada, se usa esa antes que SMTP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "Authorized redirect URI" del cliente OAuth:
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/admin/google/callback (local)
# GOOGLE_REDIRECT_URI=https://tu-dominio.vercel.app/api/admin/google/callback (producción)
GOOGLE_REDIRECT_URI=
